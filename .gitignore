# Байт-код и кэш интерпретатора
__pycache__/
*.py[cod]
*$py.class

# Виртуальное окружение и сборка
.venv/
venv/
dist/
build/
*.egg-info/
# Результат локальной сборки сайта документации (mkdocs build)
/site/

# Кэши инструментов
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Локальные данные клиента: история переписки, ключи OMEMO, журнал.
# В каталоге проекта они появляются только при запуске с явным путем, но
# попасть в репозиторий не должны никогда - это переписка и ключевой материал.
*.db
*.db-wal
*.db-shm
*.log

# Секреты. Пароль берется из внешней команды, keyring или окружения, а не из
# файла в репозитории, но запрет лучше держать явным.
.env
*.pem
*.key

# Файлы редакторов и операционной системы
.idea/
.vscode/
*.swp
.DS_Store
